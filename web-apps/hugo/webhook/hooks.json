[
  {
    "id": "deploy",
    "execute-command": "/hooks/pull.sh",
    "command-working-directory": "/src",
    "response-message": "Deploying latest changes...",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
